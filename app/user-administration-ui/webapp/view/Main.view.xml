<mvc:View
	controllerName="idts.useradministrationui.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'idts/useradministrationui/model/formatter'
	}">
	<f:DynamicPage id="page" busy="{view>/busy}" busyIndicatorDelay="0">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>appTitle}" level="H1"/>
				</f:heading>
				<f:actions>
					<Button
						text="{i18n>bugManagementOpenAction}"
						type="Transparent"
						icon="sap-icon://nav-back"
						tooltip="{i18n>bugManagementOpenActionTooltip}"
						press=".onOpenBugManagement"/>
					<Button
						text="{i18n>inviteUser}"
						type="Emphasized"
						icon="sap-icon://add-employee"
						press=".onOpenInvite"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox class="sapUiResponsiveContentPadding">
				<IconTabBar
					id="administrationTabs"
					selectedKey="{view>/selectedTab}"
					select=".onTabSelect"
					expandable="false"
					headerMode="Inline"
					tabDensityMode="Compact"
					tabsOverflowMode="End">
					<items>
						<IconTabFilter key="access" text="{i18n>accessTab}" icon="sap-icon://locked" tooltip="{i18n>accessTabTooltip}">
							<content>
								<IconTabBar id="accessSubtabs" selectedKey="{view>/selectedAccessTab}" select=".onAccessTabSelect" expandable="false" headerMode="Inline" tabDensityMode="Compact">
									<items>
						<IconTabFilter key="requests" text="{i18n>accessRequestsTab}" icon="sap-icon://request" tooltip="{i18n>accessRequestsTabTooltip}">
							<content>
								<VBox>
									<Toolbar>
										<SearchField
											width="100%"
											placeholder="{i18n>searchPlaceholder}"
											search=".onSearch"/>
									</Toolbar>
									<Table
										id="onboardingTable"
										items="{requests>/items}"
										growing="true"
										growingScrollToLoad="true"
										noDataText="{i18n>noRequests}"
										sticky="ColumnHeaders">
										<columns>
											<Column><Text text="{i18n>targetEmail}"/></Column>
											<Column width="8rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>businessRole}"/></Column>
											<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>userAdminCapability}"/></Column>
											<Column width="10rem"><Text text="{i18n>status}"/></Column>
											<Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>expiresAt}"/></Column>
											<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>deliveryIssue}"/></Column>
											<Column width="13rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
										</columns>
										<items>
											<ColumnListItem type="Inactive">
												<cells>
													<Text text="{requests>targetEmailNormalized}"/>
													<ObjectStatus text="{requests>requestedRole_code}"/>
													<ObjectStatus
														text="{= ${requests>userAdminRequested} ? ${i18n>enabled} : ${i18n>notEnabled} }"
														state="{= ${requests>userAdminRequested} ? 'Information' : 'None' }"/>
													<ObjectStatus
														text="{requests>status_code}"
														state="{path: 'requests>status_code', formatter: 'formatter.statusState'}"/>
													<Text text="{path: 'requests>expiresAt', formatter: 'formatter.dateTime'}"/>
													<ObjectStatus text="{requests>lastErrorSummary}" state="Error"/>
													<HBox justifyContent="End" renderType="Bare">
														<Button
															icon="sap-icon://accept"
															tooltip="{i18n>approveProvisioning}"
															visible="{= ${requests>status_code} === 'PENDING_APPROVAL' }"
															press=".onApproveProvisioning"/>
														<Button
															icon="sap-icon://refresh"
															tooltip="{i18n>retryProvisioning}"
															visible="{= ${requests>status_code} === 'RETRYABLE_FAILURE' || (${requests>status_code} === 'BLOCKED_MANUAL_REVIEW' &amp;&amp; ${requests>lastErrorCode} === 'PROVIDER_REQUEST_INVALID' &amp;&amp; ${requests>latestOperationAttemptCount} === 4) }"
															press=".onRetryAccessOperation"/>
												<Button
													icon="sap-icon://synchronize"
													tooltip="{i18n>reconcileProvisioning}"
													visible="{= ${requests>status_code} === 'BLOCKED_MANUAL_REVIEW' &amp;&amp; ${requests>lastErrorCode} === 'AMBIGUOUS_PROVIDER_OUTCOME' }"
													press=".onReconcileAccessOperation"/>
												<Button
													icon="sap-icon://sys-cancel"
													type="Negative"
													tooltip="{i18n>cancelExistingLinkInvitation}"
													visible="{requests>cancelEligible}"
													press=".onCancelExistingLinkInvitation"/>
											</HBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</VBox>
							</content>
						</IconTabFilter>
						<IconTabFilter key="activeUsers" text="{i18n>activeUsersTab}" icon="sap-icon://employee" tooltip="{i18n>activeUsersTabTooltip}">
							<content>
								<VBox>
									<Toolbar>
										<SearchField
											width="100%"
											value="{activeUsers>/query}"
											placeholder="{i18n>activeUserSearchPlaceholder}"
											search=".onActiveUsersSearch"/>
										<ToolbarSpacer/>
										<CheckBox
											selected="{activeUsers>/includeNonActive}"
											text="{i18n>includeRevoked}"
											select=".onActiveUsersFilterChange"/>
										<Button
											icon="sap-icon://refresh"
											tooltip="{i18n>retryActiveUsers}"
											press=".onRetryActiveUsers"/>
									</Toolbar>
									<MessageStrip
										visible="{activeUsers>/error}"
										text="{i18n>activeUsersLoadFailed}"
										type="Error"
										showIcon="true"
										class="sapUiTinyMarginTop"/>
									<Table
										id="activeUsersTable"
										items="{activeUsers>/items}"
										busy="{activeUsers>/busy}"
										noDataText="{i18n>noActiveUsers}"
										sticky="ColumnHeaders">
										<columns>
											<Column><Text text="{i18n>user}"/></Column>
											<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>businessRole}"/></Column>
											<Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>userAdminCapability}"/></Column>
											<Column width="9rem"><Text text="{i18n>accessState}"/></Column>
											<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>identityLinked}"/></Column>
											<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>developerReady}"/></Column>
											<Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>pendingOperation}"/></Column>
											<Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>lastReconciled}"/></Column>
											<Column width="8rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
										</columns>
										<items>
											<ColumnListItem type="Inactive">
												<cells>
													<ObjectIdentifier title="{activeUsers>displayName}" text="{activeUsers>email}"/>
												<ObjectStatus text="{activeUsers>businessRole}"/>
												<ObjectStatus text="{= ${activeUsers>userAdminCapability} ? ${i18n>enabled} : ${i18n>notEnabled} }"/>
													<ObjectStatus
														text="{
															parts: [
																{ path: 'activeUsers>accessState' },
																{ path: 'i18n>activeStateText' },
																{ path: 'i18n>suspendedStateText' },
																{ path: 'i18n>revokedStateText' },
																{ path: 'i18n>incompleteStateText' }
															],
															formatter: 'formatter.accessStateText'
														}"
														state="{path: 'activeUsers>accessState', formatter: 'formatter.accessStateState'}"/>
													<ObjectStatus
														text="{
															parts: [
																{ path: 'activeUsers>identityLinked' },
																{ path: 'i18n>yes' },
																{ path: 'i18n>no' }
															],
															formatter: 'formatter.booleanText'
														}"
														state="{path: 'activeUsers>identityLinked', formatter: 'formatter.booleanState'}"/>
													<ObjectStatus
														text="{
															parts: [
																{ path: 'activeUsers>developerReady' },
																{ path: 'i18n>readyText' },
																{ path: 'i18n>needsAttentionText' }
															],
															formatter: 'formatter.developerReadyText'
														}"
														state="{path: 'activeUsers>developerReady', formatter: 'formatter.booleanState'}"/>
													<ObjectStatus
														text="{
															parts: [
																{ path: 'activeUsers>pendingOperationState' },
																{ path: 'i18n>noneText' },
																{ path: 'i18n>pendingText' },
																{ path: 'i18n>inProgressText' },
																{ path: 'i18n>retryNeededText' },
																{ path: 'i18n>manualReviewText' }
															],
															formatter: 'formatter.pendingOperationText'
														}"
														state="{path: 'activeUsers>pendingOperationState', formatter: 'formatter.operationState'}"/>
													<Text text="{path: 'activeUsers>lastReconciledAt', formatter: 'formatter.dateTime'}"/>
													<Button text="{i18n>viewDetails}" type="Transparent" press=".onOpenActiveUserDetails"/>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
									<Button
										text="{i18n>loadMoreActiveUsers}"
										type="Transparent"
										visible="{activeUsers>/hasMore}"
										enabled="{= !${activeUsers>/busy} }"
										press=".onLoadMoreActiveUsers"
										class="sapUiTinyMarginTop"/>
								</VBox>
							</content>
						</IconTabFilter>
									</items>
								</IconTabBar>
							</content>
						</IconTabFilter>
						<IconTabFilter key="developers" text="{i18n>developersTab}" icon="sap-icon://activity-individual" tooltip="{i18n>developersTabTooltip}">
							<content>
								<IconTabBar id="developerSubtabs" selectedKey="{view>/selectedDeveloperTab}" select=".onDeveloperTabSelect" expandable="false" headerMode="Inline" tabDensityMode="Compact">
									<items>
										<IconTabFilter key="developerWorkload" text="{i18n>developerWorkloadTab}" icon="sap-icon://bar-chart" tooltip="{i18n>developerWorkloadTabTooltip}">
											<content>
												<VBox>
													<MessageStrip
														text="{i18n>developerWorkloadOwnershipNote}"
														type="Information"
														showIcon="true"/>
													<Toolbar>
														<SearchField
															width="100%"
															value="{workload>/query}"
															placeholder="{i18n>developerWorkloadSearchPlaceholder}"
															search=".onDeveloperWorkloadSearch"/>
														<ToolbarSpacer/>
														<Button
															icon="sap-icon://refresh"
															tooltip="{i18n>refreshDeveloperWorkload}"
															press=".onRefreshDeveloperWorkload"/>
													</Toolbar>
													<MessageStrip
														visible="{workload>/error}"
														text="{i18n>developerWorkloadLoadFailed}"
														type="Error"
														showIcon="true"
														class="sapUiTinyMarginTop"/>
													<Table
														id="developerWorkloadTable"
														items="{workload>/items}"
														busy="{workload>/busy}"
														noDataText="{i18n>noDeveloperWorkloads}"
														sticky="ColumnHeaders"
														autoPopinMode="true">
														<columns>
															<Column importance="High"><Text text="{i18n>user}"/></Column>
															<Column width="10rem"><Text text="{i18n>availability}"/></Column>
															<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>accessReadinessLabel}"/></Column>
															<Column width="9rem"><Text text="{i18n>openLimit}"/></Column>
															<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>needsDeveloperAction}"/></Column>
															<Column width="7rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>overdue}"/></Column>
															<Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>estimatedEffort}"/></Column>
															<Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>workloadStatus}"/></Column>
															<Column width="11rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
														</columns>
														<items>
															<ColumnListItem type="Inactive">
																<cells>
																	<ObjectIdentifier title="{workload>developerName}" text="{workload>developerEmail}"/>
																	<ObjectStatus
																		text="{workload>availabilityStatusName}"
																		state="{parts: [{path: 'workload>availabilityCriticality'}], formatter: 'formatter.availabilityState'}"/>
																	<ObjectStatus
																		text="{parts: [{path: 'workload>identityAccessReady'}, {path: 'i18n>accessReadinessReadyText'}, {path: 'i18n>accessReadinessAttentionText'}, {path: 'i18n>accessReadinessLabel'}], formatter: 'formatter.workloadReadinessText'}"
																		state="{path: 'workload>identityAccessReady', formatter: 'formatter.workloadReadinessState'}"/>
																	<Text text="{parts: [{path: 'workload>openOwnedBugCount'}, {path: 'workload>workloadLimit'}], formatter: 'formatter.workloadOpenLimit'}"/>
																	<ObjectNumber number="{workload>currentActionItemCount}" unit="{i18n>developerActionUnit}"/>
																	<ObjectNumber number="{workload>overdueOwnedBugCount}" state="{path: 'workload>overdueOwnedBugCount', formatter: 'formatter.workloadCountState'}"/>
																	<ObjectNumber number="{workload>estimatedEffortHoursTotal}" unit="{i18n>hoursShort}"/>
																	<ObjectStatus
																		text="{parts: [{path: 'workload>isOverloaded'}, {path: 'workload>overdueOwnedBugCount'}, {path: 'i18n>overloadedText'}, {path: 'i18n>overdueText'}, {path: 'i18n>withinLimitText'}], formatter: 'formatter.workloadStateText'}"
																		state="{parts: [{path: 'workload>isOverloaded'}, {path: 'workload>overdueOwnedBugCount'}, {path: 'workload>active'}], formatter: 'formatter.workloadState'}"/>
																	<HBox justifyContent="End" renderType="Bare">
																		<Button text="{i18n>viewWorkload}" type="Transparent" press=".onOpenDeveloperWorkload"/>
																	</HBox>
																</cells>
															</ColumnListItem>
														</items>
													</Table>
													<Button
														text="{i18n>loadMoreDeveloperWorkloads}"
														type="Transparent"
														visible="{workload>/hasMore}"
														enabled="{= !${workload>/busy} }"
														press=".onLoadMoreDeveloperWorkload"
														class="sapUiTinyMarginTop"/>
												</VBox>
											</content>
										</IconTabFilter>
										<IconTabFilter key="developerResponsibilities" text="{i18n>developerResponsibilitiesTab}" icon="sap-icon://action-settings" tooltip="{i18n>developerResponsibilitiesTabTooltip}">
							<content>
								<VBox>
									<MessageStrip
										text="{i18n>developerResponsibilitiesEntry}"
										type="Information"
										showIcon="true"/>
									<Table
										id="developerResponsibilitiesTable"
										items="{activeUsers>/developerItems}"
										busy="{activeUsers>/busy}"
										noDataText="{i18n>activeUsersNoDeveloper}"
										sticky="ColumnHeaders">
										<columns>
											<Column><Text text="{i18n>user}"/></Column>
											<Column width="11rem"><Text text="{i18n>developerReady}"/></Column>
											<Column width="11rem"><Text text="{i18n>activeResponsibilityCount}"/></Column>
											<Column width="8rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
										</columns>
										<items>
											<ColumnListItem type="Inactive">
												<cells>
													<ObjectIdentifier title="{activeUsers>displayName}" text="{activeUsers>email}"/>
													<ObjectStatus
														text="{
															parts: [
																{ path: 'activeUsers>developerReady' },
																{ path: 'i18n>readyText' },
																{ path: 'i18n>needsAttentionText' }
															],
															formatter: 'formatter.developerReadyText'
														}"
														state="{path: 'activeUsers>developerReady', formatter: 'formatter.booleanState'}"/>
													<ObjectNumber number="{activeUsers>activeResponsibilityCount}"/>
													<HBox justifyContent="End" renderType="Bare">
														<Button text="{i18n>viewDetails}" type="Transparent" press=".onOpenActiveUserDetails"/>
												<Button icon="sap-icon://action-settings" tooltip="{i18n>manageResponsibilitiesActionTooltip}" type="Transparent" visible="{= ${activeUsers>accessState} === 'ACTIVE' }" press=".onOpenDeveloperProfile"/>
													</HBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
									<Button
										text="{i18n>loadMoreActiveUsers}"
										type="Transparent"
										visible="{activeUsers>/hasMore}"
										enabled="{= !${activeUsers>/busy} }"
										press=".onLoadMoreActiveUsers"
										class="sapUiTinyMarginTop"/>
								</VBox>
							</content>
						</IconTabFilter>
									</items>
								</IconTabBar>
							</content>
						</IconTabFilter>
						<IconTabFilter key="operations" text="{i18n>operationsTab}" icon="sap-icon://activity-items" tooltip="{i18n>operationsTabTooltip}">
							<content>
								<VBox>
									<HBox justifyContent="SpaceBetween" wrap="Wrap" class="sapUiTinyMarginBottom">
										<ObjectStatus text="{parts: [{path: 'adminReadiness>/emailDeliveryState'}, {path: 'i18n>emailDeliveryState'}, {path: 'i18n>availableText'}, {path: 'i18n>unavailableText'}, {path: 'i18n>recentSuccessText'}, {path: 'i18n>staleText'}, {path: 'i18n>unknownText'}], formatter: 'formatter.readinessText'}" state="{path: 'adminReadiness>/emailDeliveryState', formatter: 'formatter.readinessState'}"/>
										<ObjectStatus text="{parts: [{path: 'adminReadiness>/provisioningBrokerState'}, {path: 'i18n>provisioningState'}, {path: 'i18n>availableText'}, {path: 'i18n>unavailableText'}, {path: 'i18n>recentSuccessText'}, {path: 'i18n>staleText'}, {path: 'i18n>unknownText'}], formatter: 'formatter.readinessText'}" state="{path: 'adminReadiness>/provisioningBrokerState', formatter: 'formatter.readinessState'}"/>
										<Text text="{parts: [{path: 'adminReadiness>/lastSuccessfulReconciliationAt'}, {path: 'i18n>lastSuccessfulReconciliation'}], formatter: 'formatter.readinessLastSuccess'}"/>
									</HBox>
									<MessageStrip visible="{adminReadiness>/error}" text="{i18n>readinessLoadFailed}" type="Error" showIcon="true"/>
									<IconTabBar id="operationsSubtabs" selectedKey="{view>/selectedOperationsTab}" select=".onOperationsTabSelect" expandable="false" applyContentPadding="false">
										<items>
											<IconTabFilter key="deliveries" text="{i18n>deliveryOperationsTab}" icon="sap-icon://email">
												<content>
													<VBox>
														<Toolbar>
															<SearchField width="100%" placeholder="{i18n>deliverySearchPlaceholder}" search=".onDeliverySearch"/>
															<Select selectedKey="{deliveries>/status}" change=".onDeliveryStatusChange" tooltip="{i18n>deliveryStatusFilter}">
																<core:Item key="" text="{i18n>allStatuses}"/>
																<core:Item key="PENDING" text="{i18n>pendingText}"/>
																<core:Item key="FAILED" text="{i18n>failedText}"/>
																<core:Item key="SENT" text="{i18n>sentText}"/>
															</Select>
															<Select selectedKey="{deliveries>/deliveryType}" change=".onDeliveryTypeChange" tooltip="{i18n>deliveryTypeFilter}">
																<core:Item key="ALL" text="{i18n>allDeliveryTypes}"/>
																<core:Item key="INVITATION" text="{i18n>invitationDeliveryType}"/>
																	<core:Item key="ACCESS_CHANGE" text="{i18n>accessChangeDeliveryType}"/>
																	<core:Item key="DIGEST" text="{i18n>digestDeliveryType}"/>
															</Select>
															<Button icon="sap-icon://refresh" tooltip="{i18n>refreshOperations}" press=".onRefreshOperations"/>
														</Toolbar>
														<MessageStrip visible="{deliveries>/error}" text="{i18n>deliveryLoadFailed}" type="Error" showIcon="true"/>
														<Table id="deliveryOperationsTable" items="{deliveries>/items}" busy="{deliveries>/busy}" noDataText="{i18n>noDeliveries}" sticky="ColumnHeaders" autoPopinMode="true">
															<columns>
																<Column width="10rem"><Text text="{i18n>deliveryType}"/></Column>
																<Column width="11rem"><Text text="{i18n>deliveryEvent}"/></Column>
																<Column importance="High"><Text text="{i18n>recipient}"/></Column>
																<Column width="9rem"><Text text="{i18n>deliveryStatus}"/></Column>
																<Column width="7rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>attempts}"/></Column>
																<Column width="12rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>nextAttempt}"/></Column>
																<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>deliveryError}"/></Column>
																<Column width="11rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
															</columns>
															<items>
																<ColumnListItem type="Inactive">
																	<cells>
																		<Text text="{deliveries>deliveryTypeLabel}"/>
																		<Text text="{deliveries>eventTypeLabel}"/>
																		<Text text="{deliveries>recipientDisplay}"/>
																	<ObjectStatus text="{parts: [{path: 'deliveries>status'}, {path: 'i18n>pendingText'}, {path: 'i18n>failedText'}, {path: 'i18n>sentText'}, {path: 'i18n>skippedText'}, {path: 'i18n>unknownText'}], formatter: 'formatter.statusText'}" state="{path: 'deliveries>status', formatter: 'formatter.statusState'}"/>
																		<ObjectNumber number="{deliveries>attemptCount}"/>
																		<Text text="{path: 'deliveries>nextAttemptAt', formatter: 'formatter.dateTime'}"/>
																		<Text text="{deliveries>safeErrorSummary}"/>
																		<HBox justifyContent="End" renderType="Bare">
																			<Button icon="sap-icon://detail-view" tooltip="{i18n>viewDetails}" press=".onOpenDeliveryDetails"/>
															<Button icon="sap-icon://refresh" tooltip="{i18n>retryDelivery}" visible="{deliveries>canRetry}" enabled="{= !${view>/busy} }" press=".onRetryOnboardingDelivery"/>
																		</HBox>
																	</cells>
																</ColumnListItem>
															</items>
														</Table>
														<Button text="{i18n>loadMoreOperations}" type="Transparent" visible="{deliveries>/hasMore}" enabled="{= !${deliveries>/busy} }" press=".onLoadMoreDeliveries"/>
													</VBox>
												</content>
											</IconTabFilter>
											<IconTabFilter key="provisioning" text="{i18n>provisioningOperationsTab}" icon="sap-icon://synchronize">
												<content>
													<VBox>
														<Toolbar>
															<Select selectedKey="{operations>/state}" change=".onProvisioningFilterChange" tooltip="{i18n>operationStateFilter}">
																<core:Item key="" text="{i18n>allStatuses}"/>
																<core:Item key="RETRYABLE_FAILURE" text="{i18n>retryNeededText}"/>
																<core:Item key="BLOCKED_MANUAL_REVIEW" text="{i18n>manualReviewText}"/>
																<core:Item key="SUCCEEDED" text="{i18n>completedText}"/>
															</Select>
															<Select selectedKey="{operations>/operationType}" change=".onProvisioningFilterChange" tooltip="{i18n>operationTypeFilter}">
																<core:Item key="" text="{i18n>allOperations}"/>
																<core:Item key="PROVISION" text="{i18n>provisionOperation}"/>
																<core:Item key="CHANGE_ROLE" text="{i18n>changeRoleOperation}"/>
																<core:Item key="REVOKE" text="{i18n>revokeOperation}"/>
																<core:Item key="REACTIVATE" text="{i18n>reactivateOperation}"/>
															</Select>
															<Button icon="sap-icon://refresh" tooltip="{i18n>refreshOperations}" press=".onRefreshOperations"/>
														</Toolbar>
														<MessageStrip visible="{operations>/error}" text="{i18n>operationsLoadFailed}" type="Error" showIcon="true"/>
														<Table id="provisioningOperationsTable" items="{operations>/items}" busy="{operations>/busy}" noDataText="{i18n>noOperations}" sticky="ColumnHeaders" autoPopinMode="true">
															<columns>
																<Column importance="High"><Text text="{i18n>operation}"/></Column>
																<Column width="10rem"><Text text="{i18n>operationState}"/></Column>
																<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>requestedBy}"/></Column>
																<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>target}"/></Column>
																<Column width="7rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>attempts}"/></Column>
																<Column width="14rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
															</columns>
															<items>
															<ColumnListItem type="Inactive">
																<cells>
																	<Text text="{parts: [{path: 'operations>operationType'}, {path: 'i18n>provisionOperation'}, {path: 'i18n>changeRoleOperation'}, {path: 'i18n>revokeOperation'}, {path: 'i18n>reactivateOperation'}, {path: 'i18n>linkExistingOperation'}], formatter: 'formatter.operationTypeText'}"/>
																		<ObjectStatus text="{path: 'operations>state', formatter: 'formatter.operationStateText'}" state="{path: 'operations>state', formatter: 'formatter.operationState'}"/>
																		<Text text="{operations>requestedByDisplay}"/>
																		<Text text="{operations>targetDisplay}"/>
																		<ObjectNumber number="{operations>attemptCount}"/>
																		<HBox justifyContent="End" renderType="Bare">
																			<Button icon="sap-icon://detail-view" tooltip="{i18n>viewDetails}" press=".onOpenOperationDetails"/>
																	<Button icon="sap-icon://refresh" tooltip="{i18n>retryProvisioning}" visible="{operations>canRetry}" enabled="{= !${view>/busy} }" press=".onRetryAccessOperation"/>
																	<Button icon="sap-icon://synchronize" tooltip="{i18n>reconcileProvisioning}" visible="{operations>canReconcile}" enabled="{= !${view>/busy} }" press=".onReconcileAccessOperation"/>
																		</HBox>
																	</cells>
																</ColumnListItem>
															</items>
														</Table>
														<Button text="{i18n>loadMoreOperations}" type="Transparent" visible="{operations>/hasMore}" enabled="{= !${operations>/busy} }" press=".onLoadMoreOperations"/>
													</VBox>
												</content>
											</IconTabFilter>
										</items>
									</IconTabBar>
								</VBox>
							</content>
						</IconTabFilter>
						<IconTabFilter key="audit" text="{i18n>auditTab}" icon="sap-icon://activity-2" tooltip="{i18n>auditTabTooltip}">
							<content>
								<VBox>
															<Toolbar>
																<Select selectedKey="{audit>/action}" change=".onAuditFilterChange" tooltip="{i18n>auditActionFilter}">
																	<core:Item key="" text="{i18n>allActions}"/>
																	<core:Item key="PROVISION" text="{i18n>provisionOperation}"/>
																	<core:Item key="CHANGE_ROLE" text="{i18n>changeRoleOperation}"/>
																	<core:Item key="REVOKE" text="{i18n>revokeOperation}"/>
																	<core:Item key="REACTIVATE" text="{i18n>reactivateOperation}"/>
																	<core:Item key="LINK_EXISTING" text="{i18n>linkExistingOperation}"/>
																	<core:Item key="RETRY_ONBOARDING_DELIVERY" text="{i18n>retryDelivery}"/>
																	<core:Item key="RETRY_ACCESS_OPERATION" text="{i18n>retryProvisioning}"/>
																	<core:Item key="RECONCILE_ACCESS_OPERATION" text="{i18n>reconcileProvisioning}"/>
																</Select>
																<Select selectedKey="{audit>/result}" change=".onAuditFilterChange" tooltip="{i18n>auditResultFilter}">
											<core:Item key="" text="{i18n>allResults}"/>
											<core:Item key="QUEUED" text="{i18n>queuedText}"/>
											<core:Item key="APPLIED" text="{i18n>completedText}"/>
											<core:Item key="RETRYABLE_FAILURE" text="{i18n>retryNeededText}"/>
										</Select>
										<DatePicker value="{audit>/from}" valueFormat="yyyy-MM-dd" displayFormat="medium" change=".onAuditFilterChange" placeholder="{i18n>fromDate}" tooltip="{i18n>fromDate}"/>
										<DatePicker value="{audit>/to}" valueFormat="yyyy-MM-dd" displayFormat="medium" change=".onAuditFilterChange" placeholder="{i18n>toDate}" tooltip="{i18n>toDate}"/>
										<Button icon="sap-icon://refresh" tooltip="{i18n>refreshAudit}" press=".onRefreshAudit"/>
									</Toolbar>
									<MessageStrip visible="{audit>/error}" text="{i18n>auditLoadFailed}" type="Error" showIcon="true"/>
									<Table id="administrationAuditTable" items="{audit>/items}" busy="{audit>/busy}" noDataText="{i18n>noAuditEvents}" sticky="ColumnHeaders" autoPopinMode="true">
										<columns>
											<Column importance="High"><Text text="{i18n>auditAction}"/></Column>
											<Column width="9rem"><Text text="{i18n>auditResult}"/></Column>
											<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>actor}"/></Column>
											<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>target}"/></Column>
											<Column width="12rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>occurredAt}"/></Column>
											<Column width="9rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
										</columns>
										<items>
																<ColumnListItem type="Inactive">
																	<cells>
																		<Text text="{parts: [{path: 'audit>action'}, {path: 'i18n>provisionOperation'}, {path: 'i18n>changeRoleOperation'}, {path: 'i18n>revokeOperation'}, {path: 'i18n>reactivateOperation'}, {path: 'i18n>linkExistingOperation'}, {path: 'i18n>suspendAccess'}, {path: 'i18n>reactivateAccess'}, {path: 'i18n>retryDelivery'}, {path: 'i18n>retryProvisioning'}, {path: 'i18n>reconcileProvisioning'}], formatter: 'formatter.auditActionText'}"/>
																		<ObjectStatus text="{parts: [{path: 'audit>result'}, {path: 'i18n>queuedText'}, {path: 'i18n>appliedText'}, {path: 'i18n>retryNeededText'}, {path: 'i18n>rejectedText'}], formatter: 'formatter.resultText'}" state="{path: 'audit>result', formatter: 'formatter.statusState'}"/>
													<Text text="{audit>actorDisplay}"/>
													<Text text="{audit>targetDisplay}"/>
													<Text text="{path: 'audit>occurredAt', formatter: 'formatter.dateTime'}"/>
													<Button icon="sap-icon://detail-view" tooltip="{i18n>viewDetails}" press=".onOpenAuditDetails"/>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
									<Button text="{i18n>loadMoreOperations}" type="Transparent" visible="{audit>/hasMore}" enabled="{= !${audit>/busy} }" press=".onLoadMoreAudit"/>
								</VBox>
							</content>
						</IconTabFilter>
						<IconTabFilter key="businessCatalogs" text="{i18n>businessCatalogsTab}" icon="sap-icon://tags" tooltip="{i18n>businessCatalogsTabTooltip}">
							<content>
								<VBox>
									<IconTabBar id="catalogTypeTabs" selectedKey="{businessCatalogs>/selectedType}" select=".onCatalogTypeChange" expandable="false" applyContentPadding="false">
										<items>
											<IconTabFilter key="SAP_MODULE" text="{i18n>sapModulesCatalog}"/>
											<IconTabFilter key="APPLICATION_COMPONENT" text="{i18n>applicationComponentsCatalog}"/>
											<IconTabFilter key="DEFECT_CATEGORY" text="{i18n>defectCategoriesCatalog}"/>
											<IconTabFilter key="COMPONENT_CATEGORY" text="{i18n>componentCategoriesCatalog}"/>
										</items>
									</IconTabBar>
									<Toolbar>
										<SearchField width="100%" placeholder="{i18n>catalogSearchPlaceholder}" search=".onCatalogSearch"/>
										<CheckBox text="{i18n>includeInactiveCatalogs}" selected="{businessCatalogs>/includeInactive}" select=".onCatalogInactiveFilterChange"/>
										<Button icon="sap-icon://refresh" tooltip="{i18n>refreshCatalogs}" press=".onRetryCatalogs"/>
										<Button text="{i18n>addCatalogItem}" type="Emphasized" icon="sap-icon://add" press=".onOpenCatalogCreate"/>
									</Toolbar>
									<MessageStrip visible="{businessCatalogs>/error}" text="{i18n>catalogLoadFailed}" type="Error" showIcon="true"/>
									<Table id="businessCatalogsTable" items="{businessCatalogs>/items}" busy="{businessCatalogs>/busy}" noDataText="{i18n>noCatalogItems}" sticky="ColumnHeaders">
										<columns>
											<Column width="12rem"><Text text="{i18n>catalogCode}"/></Column>
											<Column><Text text="{i18n>catalogName}"/></Column>
											<Column width="10rem"><Text text="{i18n>catalogClassificationType}"/></Column>
											<Column width="8rem"><Text text="{i18n>catalogStatus}"/></Column>
											<Column width="15rem" hAlign="End"><Text text="{i18n>actions}"/></Column>
										</columns>
										<items>
											<ColumnListItem type="Inactive">
												<cells>
													<Text text="{businessCatalogs>displayCode}" wrapping="false"/>
													<Text text="{businessCatalogs>displayName}" wrapping="false"/>
													<Text text="{businessCatalogs>displayType}" wrapping="false"/>
													<ObjectStatus text="{= ${businessCatalogs>active} ? ${i18n>activeStateText} : ${i18n>inactiveCatalogState} }" state="{= ${businessCatalogs>active} ? 'Success' : 'None' }"/>
													<HBox justifyContent="End">
														<Button text="{i18n>editCatalogItem}" type="Transparent" press=".onOpenCatalogEdit"/>
														<Button text="{= ${businessCatalogs>active} ? ${i18n>deactivateCatalogItem} : ${i18n>activateCatalogItem} }" type="Transparent" press=".onToggleCatalogActive"/>
													</HBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</VBox>
							</content>
						</IconTabFilter>
					</items>
				</IconTabBar>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
