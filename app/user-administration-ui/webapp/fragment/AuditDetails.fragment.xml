<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" core:require="{ formatter: 'idts/useradministrationui/model/formatter' }">
	<Dialog title="{i18n>auditDetails}" contentWidth="32rem" draggable="true" resizable="true">
		<content>
			<VBox class="sapUiSmallMargin">
				<Label text="{i18n>auditAction}"/>
				<Text text="{audit>/selected/action}"/>
				<Label text="{i18n>auditResult}" class="sapUiSmallMarginTop"/>
				<ObjectStatus text="{audit>/selected/result}" state="{path: 'audit>/selected/result', formatter: 'formatter.statusState'}"/>
				<Label text="{i18n>fromState}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/fromState}"/>
				<Label text="{i18n>toState}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/toState}"/>
				<Label text="{i18n>actor}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/actorDisplay}"/>
				<Label text="{i18n>target}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/targetDisplay}"/>
				<Label text="{i18n>correlationFingerprint}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/correlationFingerprint}"/>
				<Label text="{i18n>safeDetails}" class="sapUiSmallMarginTop"/>
				<Text text="{audit>/selected/detailsSummary}" wrapping="true"/>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>close}" press=".onCloseAuditDetails"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>
