<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="manageDeveloperProfileDialog" title="{i18n>manageResponsibilities}" contentWidth="42rem" stretch="{device>/system/phone}" busy="{developer>/submitting}" busyIndicatorDelay="0">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip text="{= ${i18n>openBugImpact} + ': ' + ${developer>/openBugImpactCount} }" type="Information" showIcon="true"/>
				<MessageStrip text="{i18n>existingBugsKeepAssignee}" type="Information" showIcon="true" class="sapUiTinyMarginTop"/>
				<Label text="{i18n>availability}" required="true" class="sapUiSmallMarginTop"/>
			<Select selectedKey="{developer>/developerProfile/availabilityStatusCode}" items="{developerCatalogs>/availabilityStatuses}"><core:Item key="{developerCatalogs>code}" text="{developerCatalogs>name}"/></Select>
				<Label text="{i18n>workloadLimit}" required="true" class="sapUiSmallMarginTop"/>
				<Input type="Number" min="1" value="{developer>/developerProfile/workloadLimit}"/>
				<Title text="{i18n>developerResponsibilities}" level="H5" class="sapUiSmallMarginTop"/>
				<List items="{developer>/developerProfile/responsibilities}" noDataText="{i18n>responsibilityRequired}">
					<CustomListItem>
						<VBox class="sapUiTinyMarginBottom">
						<Select selectedKey="{developer>componentCategoryID}" items="{developerCatalogs>/componentCategories}"><core:Item key="{developerCatalogs>ID}" text="{developerCatalogs>label}"/></Select>
						<Select forceSelection="false" selectedKey="{developer>sapModuleID}" items="{developerCatalogs>/sapModules}"><core:Item key="{developerCatalogs>ID}" text="{developerCatalogs>name}"/></Select>
						<Select selectedKey="{developer>responsibilityLevelCode}" items="{developerCatalogs>/responsibilityLevels}"><core:Item key="{developerCatalogs>code}" text="{developerCatalogs>name}"/></Select>
							<Button text="{i18n>removeResponsibility}" type="Transparent" press=".onRemoveDeveloperResponsibility"/>
						</VBox>
					</CustomListItem>
				</List>
				<Button text="{i18n>addResponsibility}" icon="sap-icon://add" type="Transparent" press=".onAddDeveloperResponsibility"/>
				<Label text="{i18n>reason}" required="true" class="sapUiSmallMarginTop"/>
				<TextArea value="{developer>/reason}" valueLiveUpdate="true" maxLength="500" rows="3" width="100%"/>
			</VBox>
		</content>
		<beginButton><Button text="{i18n>saveResponsibilities}" type="Emphasized" press=".onConfirmDeveloperProfile" enabled="{= !!${developer>/reason} &amp;&amp; !${developer>/submitting} }"/></beginButton>
		<endButton><Button text="{i18n>cancel}" press=".onCancelDeveloperProfile"/></endButton>
	</Dialog>
</core:FragmentDefinition>
