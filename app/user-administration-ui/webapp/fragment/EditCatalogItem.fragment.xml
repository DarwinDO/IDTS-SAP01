<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog title="{i18n>editCatalogItem}" busy="{businessCatalogs>/edit/submitting}" contentWidth="34rem">
		<content>
			<VBox class="sapUiSmallMargin">
			<Label text="{i18n>catalogCode}" required="true" visible="{= ${businessCatalogs>/selectedType} !== 'COMPONENT_CATEGORY' }"/>
			<Input value="{businessCatalogs>/edit/code}" maxLength="40" valueState="{= ${businessCatalogs>/edit/validation/code} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/code}" visible="{= ${businessCatalogs>/selectedType} !== 'COMPONENT_CATEGORY' }"/>
			<Label text="{i18n>catalogName}" required="true" visible="{= ${businessCatalogs>/selectedType} !== 'COMPONENT_CATEGORY' }"/>
			<Input value="{businessCatalogs>/edit/name}" maxLength="120" valueState="{= ${businessCatalogs>/edit/validation/name} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/name}" visible="{= ${businessCatalogs>/selectedType} !== 'COMPONENT_CATEGORY' }"/>
			<Label text="{i18n>componentType}" visible="{= ${businessCatalogs>/selectedType} === 'APPLICATION_COMPONENT' }"/>
			<Input value="{businessCatalogs>/edit/componentType}" maxLength="60" valueState="{= ${businessCatalogs>/edit/validation/componentType} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/componentType}" visible="{= ${businessCatalogs>/selectedType} === 'APPLICATION_COMPONENT' }"/>
			<Label text="{i18n>categoryType}" visible="{= ${businessCatalogs>/selectedType} === 'DEFECT_CATEGORY' }"/>
			<Input value="{businessCatalogs>/edit/categoryType}" maxLength="60" valueState="{= ${businessCatalogs>/edit/validation/categoryType} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/categoryType}" visible="{= ${businessCatalogs>/selectedType} === 'DEFECT_CATEGORY' }"/>
			<Label text="{i18n>applicationComponent}" required="true" visible="{= ${businessCatalogs>/selectedType} === 'COMPONENT_CATEGORY' }"/>
			<Select selectedKey="{businessCatalogs>/edit/component_ID}" valueState="{= ${businessCatalogs>/edit/validation/component_ID} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/component_ID}" items="{businessCatalogs>/componentOptions}" visible="{= ${businessCatalogs>/selectedType} === 'COMPONENT_CATEGORY' }">
				<core:Item key="{businessCatalogs>ID}" text="{businessCatalogs>name}"/>
				</Select>
			<Label text="{i18n>defectCategory}" required="true" visible="{= ${businessCatalogs>/selectedType} === 'COMPONENT_CATEGORY' }"/>
			<Select selectedKey="{businessCatalogs>/edit/defectCategory_ID}" valueState="{= ${businessCatalogs>/edit/validation/defectCategory_ID} ? 'Error' : 'None' }" valueStateText="{businessCatalogs>/edit/validation/defectCategory_ID}" items="{businessCatalogs>/defectOptions}" visible="{= ${businessCatalogs>/selectedType} === 'COMPONENT_CATEGORY' }">
				<core:Item key="{businessCatalogs>ID}" text="{businessCatalogs>name}"/>
				</Select>
			</VBox>
		</content>
		<beginButton><Button text="{i18n>saveCatalogItem}" type="Emphasized" enabled="{= !${businessCatalogs>/edit/submitting} }" press=".onConfirmCatalogEdit"/></beginButton>
		<endButton><Button text="{i18n>cancel}" press=".onCancelCatalogEdit"/></endButton>
	</Dialog>
</core:FragmentDefinition>
