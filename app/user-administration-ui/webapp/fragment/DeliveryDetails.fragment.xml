<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" core:require="{ formatter: 'idts/useradministrationui/model/formatter' }">
	<Dialog title="{i18n>deliveryDetails}" contentWidth="28rem" draggable="true" resizable="true">
		<content>
			<VBox class="sapUiResponsiveContentPadding">
				<Label text="{i18n>recipient}"/>
				<Text text="{deliveries>/selected/recipientDisplay}"/>
				<Label text="{i18n>deliveryStatus}"/>
				<ObjectStatus text="{parts: [{path: 'deliveries>/selected/status'}, {path: 'i18n>pendingText'}, {path: 'i18n>failedText'}, {path: 'i18n>sentText'}, {path: 'i18n>skippedText'}, {path: 'i18n>unknownText'}], formatter: 'formatter.statusText'}" state="{path: 'deliveries>/selected/status', formatter: 'formatter.statusState'}"/>
				<Label text="{i18n>attempts}"/>
				<Text text="{deliveries>/selected/attemptCount}"/>
				<Label text="{i18n>nextAttempt}"/>
				<Text text="{path: 'deliveries>/selected/nextAttemptAt', formatter: 'formatter.dateTime'}"/>
				<Label text="{i18n>deliveryError}"/>
				<Text text="{deliveries>/selected/safeErrorSummary}"/>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>close}" press=".onCloseDeliveryDetails"/>
		</beginButton>
	</Dialog>
</core:FragmentDefinition>
