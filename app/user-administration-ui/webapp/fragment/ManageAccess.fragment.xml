<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="manageAccessDialog"
		title="{access>/title}"
		contentWidth="30rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip
					text="{access>/warning}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginBottom"/>
				<MessageStrip
					text="{i18n>changeRoleResponsibilitiesHint}"
					type="Information"
					showIcon="true"
					visible="{= ${access>/mode} === 'CHANGE_ROLE' }"
					class="sapUiSmallMarginBottom"/>
				<Label text="{i18n>businessRole}" visible="{= ${access>/mode} === 'CHANGE_ROLE' }"/>
				<Select
					selectedKey="{access>/role}"
					visible="{= ${access>/mode} === 'CHANGE_ROLE' }"
					change=".onAccessRoleChange">
					<core:Item key="PM" text="{i18n>rolePm}"/>
					<core:Item key="TESTER" text="{i18n>roleTester}"/>
					<core:Item key="DEVELOPER" text="{i18n>roleDeveloper}"/>
				</Select>
				<VBox visible="{= ${access>/mode} === 'CHANGE_ROLE' &amp;&amp; ${access>/role} === 'DEVELOPER' }" class="sapUiSmallMarginTop">
					<Label text="{i18n>availability}" required="true"/>
					<Select selectedKey="{access>/developerProfile/availabilityStatusCode}" items="{catalogs>/availabilityStatuses}">
						<core:Item key="{catalogs>code}" text="{catalogs>name}"/>
					</Select>
					<Label text="{i18n>workloadLimit}" required="true" class="sapUiSmallMarginTop"/>
					<Input type="Number" min="1" value="{access>/developerProfile/workloadLimit}"/>
					<List items="{access>/developerProfile/responsibilities}">
						<CustomListItem>
							<VBox>
								<Select selectedKey="{access>componentCategoryID}" items="{catalogs>/componentCategories}"><core:Item key="{catalogs>ID}" text="{catalogs>label}"/></Select>
								<Select forceSelection="false" selectedKey="{access>sapModuleID}" items="{catalogs>/sapModules}"><core:Item key="{catalogs>ID}" text="{catalogs>name}"/></Select>
								<Select selectedKey="{access>responsibilityLevelCode}" items="{catalogs>/responsibilityLevels}"><core:Item key="{catalogs>code}" text="{catalogs>name}"/></Select>
								<Button text="{i18n>removeResponsibility}" type="Transparent" press=".onRemoveAccessResponsibility"/>
							</VBox>
						</CustomListItem>
					</List>
					<Button text="{i18n>addResponsibility}" icon="sap-icon://add" type="Transparent" press=".onAddAccessResponsibility"/>
				</VBox>
				<CheckBox
					text="{i18n>userAdminCapability}"
					selected="{access>/userAdminRequested}"
					enabled="{= ${access>/role} === 'PM' }"
					visible="{= ${access>/mode} === 'CHANGE_ROLE' }"
					class="sapUiSmallMarginTop"/>
				<Label text="{i18n>reason}" required="true" class="sapUiSmallMarginTop"/>
				<TextArea
					value="{access>/reason}"
					valueLiveUpdate="true"
					maxLength="500"
					rows="4"
					width="100%"
					placeholder="{i18n>reasonPlaceholder}"/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{access>/confirmText}"
				type="{= ${access>/mode} === 'REVOKE' ? 'Negative' : 'Emphasized' }"
				enabled="{= !!${access>/reason} &amp;&amp; !${access>/submitting} }"
				press=".onConfirmAccessChange"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onCancelAccessChange"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
