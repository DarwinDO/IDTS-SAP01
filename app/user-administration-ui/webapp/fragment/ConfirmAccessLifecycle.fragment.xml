<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="confirmAccessLifecycleDialog"
		title="{lifecycle>/title}"
		contentWidth="30rem"
		busy="{lifecycle>/submitting}">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip
					text="{lifecycle>/warning}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginBottom"/>
				<Label text="{i18n>reason}" required="true"/>
				<TextArea
					value="{lifecycle>/reason}"
					valueLiveUpdate="true"
					maxLength="500"
					rows="4"
					width="100%"
					placeholder="{i18n>reasonPlaceholder}"/>
			</VBox>
		</content>
		<beginButton>
			<Button
				text="{lifecycle>/confirmText}"
				type="{lifecycle>/buttonType}"
				enabled="{= !!${lifecycle>/reason} &amp;&amp; !${lifecycle>/submitting} }"
				press=".onConfirmAccessLifecycle"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onCancelAccessLifecycle"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
