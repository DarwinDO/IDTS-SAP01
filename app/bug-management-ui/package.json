{
  "name": "bug-management-ui",
  "version": "0.0.7",
  "description": "Fiori application for issue and defect tracking",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10",
    "ui5-task-zipper": "^3"
  },
  "scripts": {
    "lint": "eslint --config eslint.notification.config.mjs webapp/ext/notification webapp/Component.js",
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf",
    "build": "ui5 build preload --clean-dest",
    "start": "ui5 serve"
  }
}
