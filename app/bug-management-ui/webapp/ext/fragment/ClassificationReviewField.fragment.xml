<!-- Nút chỉ mở review dialog trong FieldGroup Classification; áp dụng suggestion vẫn cần thao tác người dùng và CAP validation. -->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:section="idts.bugmanagementui.ext.controls"
>
  <section:SmartAssignmentSection>
    <Button
      core:require="{ ClassificationReview: 'idts/bugmanagementui/ext/actions/ClassificationReview' }"
      text="{i18n>classificationReviewOpenButton}"
      icon="sap-icon://machine-learning"
      type="Default"
      press="ClassificationReview.openDialog"
    />
  </section:SmartAssignmentSection>
</core:FragmentDefinition>
