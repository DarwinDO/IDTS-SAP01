<!--
  Annotation Classification nhúng fragment này. Button gọi ClassificationReview.openDialog;
  dialog chỉ đọc suggestion, không PATCH classification. Breakpoint bắt đầu ở openDialog().
-->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:section="idts.bugmanagementui.ext.controls"
>
  <!-- Wrapper giữ cách đặt text bên trái/nút bên phải theo SAP Fiori section pattern. -->
  <section:SmartAssignmentSection
    visible="{= ${status_code} !== 'CLOSED' &amp;&amp; (${IsActiveEntity} === true || ${HasActiveEntity} === true) }"
  >
    <Button
      core:require="{ ClassificationReview: 'idts/bugmanagementui/ext/actions/ClassificationReview' }"
      text="{i18n>classificationReviewOpenButton}"
      icon="sap-icon://machine-learning"
      type="Default"
      press="ClassificationReview.openDialog"
    />
  </section:SmartAssignmentSection>
</core:FragmentDefinition>
