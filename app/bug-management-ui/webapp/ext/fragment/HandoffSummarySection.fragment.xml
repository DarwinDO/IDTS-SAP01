<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:section="idts.bugmanagementui.ext.controls"
>
  <section:SmartAssignmentSection
    class="sapUiSmallMarginTop sapUiSmallMarginBottom"
    visible="{= ${IsActiveEntity} === true }"
  >
    <Toolbar>
      <Text text="{i18n>handoffSummarySectionHint}" />
      <ToolbarSpacer />
      <Button
        core:require="{ HandoffSummaryReview: 'idts/bugmanagementui/ext/actions/HandoffSummaryReview' }"
        text="{i18n>handoffSummaryOpenButton}"
        icon="sap-icon://document-text"
        type="Default"
        press="HandoffSummaryReview.openDialog"
      />
    </Toolbar>
  </section:SmartAssignmentSection>
</core:FragmentDefinition>
