<!-- Gợi ý học/debug: PostgreSQL giữ metadata attachment; binary file nằm ở S3. UI không nhận S3 credential hoặc private URL. -->
<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unified="sap.ui.unified"
  xmlns:collab="idts.bugmanagementui.ext.controls"
>
  <collab:BugCollaborationSection uploadPendingAttachmentsOnActive="true" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
    <!-- Control cha theo dõi draft chuyển active và gọi flushPendingCreateAttachments sau SAVE. -->
    <Toolbar design="Transparent">
      <Title text="{i18n>attachmentsToolbarTitle}" level="H4" />
      <ToolbarSpacer />
      <!-- change gọi onAttachmentSelected: NEW draft queue memory; saved Bug upload metadata + binary qua CAP. -->
      <unified:FileUploader
        core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }"
        id="idtsAttachmentUploader"
        buttonOnly="true"
        buttonText="{i18n>attachmentsUploadButton}"
        icon="sap-icon://upload"
        multiple="true"
        sameFilenameAllowed="true"
        maximumFileSize="10"
        fileType="txt,pdf,png,jpg,jpeg"
        mimeType="text/plain,application/pdf,image/png,image/jpeg"
        change="Collaboration.onAttachmentSelected"
        enabled="{= (${IsActiveEntity} === true &amp;&amp; ${HasDraftEntity} !== true) || (${IsActiveEntity} !== true &amp;&amp; ${HasActiveEntity} !== true) }"
        tooltip="{i18n>attachmentsUploadTooltip}"
      />
    </Toolbar>

    <MessageStrip
      text="{i18n>attachmentsHelpText}"
      type="Information"
      showIcon="true"
      class="sapUiTinyMarginBottom"
    />
    <MessageStrip
      text="{i18n>attachmentsDraftWarning}"
      type="Information"
      showIcon="true"
      visible="{= (${IsActiveEntity} !== true &amp;&amp; ${HasActiveEntity} === true) || ${HasDraftEntity} === true }"
      class="sapUiTinyMarginBottom"
    />

    <!-- List bind navigation attachments: metadata từ PostgreSQL; download content đi qua CAP/S3 endpoint. -->
    <List
      id="idtsPendingAttachmentsList"
      items="{idtsPendingAttachments>/files}"
      visible="{= ${IsActiveEntity} !== true &amp;&amp; ${HasActiveEntity} !== true }"
      showSeparators="Inner"
      noDataText="{i18n>attachmentsPendingNoData}"
      class="sapUiTinyMarginBottom"
    >
      <StandardListItem
        core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }"
        title="{idtsPendingAttachments>name}"
        description="{idtsPendingAttachments>type}"
        info="{ path: 'idtsPendingAttachments>size', formatter: 'Collaboration.formatFileSize' }"
        icon="sap-icon://attachment"
      />
    </List>

    <Table
      id="idtsAttachmentsTable"
      inset="false"
      growing="true"
      growingScrollToLoad="true"
      noDataText="{i18n>attachmentsNoData}"
      items="{
        path: 'attachments',
        parameters: {
          $orderby: 'createdAt desc'
        }
      }"
    >
      <columns>
        <Column demandPopin="false">
          <Text text="{i18n>attachmentsFileColumn}" />
        </Column>
        <Column minScreenWidth="Tablet" demandPopin="true">
          <Text text="{i18n>attachmentsTypeColumn}" />
        </Column>
        <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End">
          <Text text="{i18n>attachmentsSizeColumn}" />
        </Column>
        <Column minScreenWidth="Tablet" demandPopin="true">
          <Text text="{i18n>attachmentsUploadedByColumn}" />
        </Column>
        <Column minScreenWidth="Tablet" demandPopin="true">
          <Text text="{i18n>attachmentsUploadedAtColumn}" />
        </Column>
        <Column hAlign="End">
          <Text text="{i18n>attachmentsActionsColumn}" />
        </Column>
      </columns>
      <ColumnListItem>
        <cells>
          <ObjectIdentifier
            title="{filename}"
            text="{i18n>attachmentsEvidenceText}"
            titleActive="false"
          />
          <Text text="{mimeType}" />
          <Text core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }" text="{ path: 'fileSize', formatter: 'Collaboration.formatFileSize' }" textAlign="End" />
          <Text core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }" text="{ path: 'createdBy', formatter: 'Collaboration.formatUploader' }" />
          <Text core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }" text="{ path: 'createdAt', formatter: 'Collaboration.formatDateTime' }" />
          <HBox justifyContent="End">
            <Button
              core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }"
              icon="sap-icon://download"
              type="Transparent"
              tooltip="{i18n>attachmentsDownloadTooltip}"
              press="Collaboration.onDownloadAttachment"
            />
            <Button
              core:require="{ Collaboration: 'idts/bugmanagementui/ext/sections/BugCollaboration' }"
              icon="sap-icon://delete"
              type="Transparent"
              tooltip="{i18n>attachmentsDeleteTooltip}"
              press="Collaboration.onDeleteAttachment"
              enabled="{= ${IsActiveEntity} === true &amp;&amp; ${HasDraftEntity} !== true }"
            />
          </HBox>
        </cells>
      </ColumnListItem>
    </Table>
  </collab:BugCollaborationSection>
</core:FragmentDefinition>
