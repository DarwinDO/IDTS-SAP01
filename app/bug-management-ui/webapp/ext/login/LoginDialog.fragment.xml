<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="loginDialog"
        title="IDTS – Sign In"
        contentWidth="400px"
        resizable="false"
        draggable="false"
        state="None"
        class="idtsLoginDialog">

        <content>
            <VBox class="sapUiSmallMargin">
                <!-- App branding -->
                <FlexBox justifyContent="Center" class="sapUiMediumMarginBottom">
                    <VBox alignItems="Center">
                        <Title
                            text="Issue and Defect Tracking System"
                            level="H4"
                            class="sapUiSmallMarginBottom"/>
                        <Label text="Please sign in to continue" design="Standard"/>
                    </VBox>
                </FlexBox>

                <!-- Error message strip -->
                <MessageStrip
                    id="loginErrorStrip"
                    text=""
                    type="Error"
                    showIcon="true"
                    visible="false"
                    class="sapUiSmallMarginBottom"/>

                <!-- Email field -->
                <Label text="Email" required="true" class="sapUiTinyMarginBottom"/>
                <Input
                    id="loginEmail"
                    placeholder="Enter your email"
                    type="Email"
                    width="100%"
                    submit=".onLoginSubmit"
                    class="sapUiSmallMarginBottom"/>

                <!-- Password field -->
                <Label text="Password" required="true" class="sapUiTinyMarginBottom"/>
                <Input
                    id="loginPassword"
                    placeholder="Enter your password"
                    type="Password"
                    width="100%"
                    submit=".onLoginSubmit"
                    class="sapUiSmallMarginBottom"/>
            </VBox>
        </content>

        <buttons>
            <Button
                id="loginButton"
                text="Sign In"
                type="Emphasized"
                press=".onLoginSubmit"/>
            <Button
                id="loginCancelButton"
                text="Cancel"
                press=".onLoginCancel"/>
        </buttons>
    </Dialog>

</core:FragmentDefinition>
