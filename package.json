    "integration:db:deploy": "cds deploy --profile integration",
    "integration:serve": "cds serve all --profile integration",
    "watch-bug-management-ui": "cds watch --open idts.bugmanagementui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/bug-management-ui"
  ],
  "cds": {
    "server": {
      "body_parser": {
        "limit": "12mb"
      }
    },
    "security": {
      "mock": {
        "defaultUsers": {
          "enabled": false
        }
      }
    },
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[integration]": {
          "kind": "postgres",
          "credentials": {
            "url": null
          }
        }
      },
      "attachments": {
        "[integration]": {
          "kind": "standard",
          "scan": false,
          "objectStore": {
            "kind": "shared"
          }
        }
      },
      "auth": {
        "restrict_all_services": false,
        "[development]": {
          "impl": "./srv/auth/custom-auth.js"
        },
        "[integration]": {
          "impl": "./srv/auth/custom-auth.js"
        },
        "[production]": {
          "impl": "./srv/auth/custom-auth.js"
        }
      }
    },
    "idts": {
      "auth": {
        "sessionTtlMinutes": 480
      },
      "email": {
        "enabled": false,
        "provider": "smtp",
        "brevoApiEndpoint": "https://api.brevo.com/v3/smtp/email",
        "secure": false,
        "maxRetryCount": 2,
        "pollIntervalMs": 15000,
        "batchSize": 10,
        "maxConnections": 3,
        "testMode": false
      },
      "ai": {
        "enabled": false,
        "provider": "mock",
        "timeoutMs": 10000,
        "maxInputChars": 8000,
        "mockMode": "success",
        "mockEmbeddingDimensions": 8
      }
    },
    "log": {
      "levels": {
        "cds": "warn",
        "cds.serve": "warn"
      }
    }
  }
}
