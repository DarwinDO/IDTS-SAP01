{
  "dependencies": {
    "@cap-js/attachments": "^3.12.2",
    "@cap-js/postgres": "^2",
    "@sap/cds": "^9.9.1"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^2",
    "@googleworkspace/cli": "^0.22.5",
    "@sap/cds-dk": "^9.9.2",
    "cds-plugin-ui5": "^0.13.0",
    "playwright": "^1.61.0"
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "sap490:gws:version": "gws --version",
    "sap490:gws:auth-status": "gws auth status",
    "sap490:gws:check": "node scripts/sap490/gws-check.mjs",
    "sap490:gws:find-review-folder": "node scripts/sap490/find-drive-folder.mjs \"SAP490 Review\"",
    "sap490:gws:dry-run": "node scripts/sap490/sync-dry-run.mjs",
    "sap490:gws:upload-review-docx": "node scripts/sap490/upload-review-docx.mjs",
    "sap490:gws:upload-review-docx:execute": "node scripts/sap490/upload-review-docx.mjs --execute",
    "sap490:gws:sync-review-sheets": "node scripts/sap490/sync-review-sheets.mjs",
    "sap490:gws:sync-review-sheets:execute": "node scripts/sap490/sync-review-sheets.mjs --execute",
    "sap490:generate:retest-pack": "python scripts/sap490/generate-retest-aligned-artifacts.py",
    "qa:comments-attachments:http": "powershell -ExecutionPolicy Bypass -File scripts/qa/test-comments-attachments.ps1",
    "qa:comments-attachments:programmatic": "node scripts/qa/test-comments-attachments-programmatic.js",
    "qa:developer-workload:programmatic": "node scripts/qa/test-developer-workload-programmatic.js",
    "qa:direct-assignee:http": "powershell -ExecutionPolicy Bypass -File scripts/qa/test-direct-assignee-draft-save.ps1",
    "qa:history-events:programmatic": "node scripts/qa/test-history-events-programmatic.js assign && node scripts/qa/test-history-events-programmatic.js resubmit && node scripts/qa/test-history-events-programmatic.js reject && node scripts/qa/test-history-events-programmatic.js pending && node scripts/qa/test-history-events-programmatic.js close && node scripts/qa/test-history-events-programmatic.js edit",
    "qa:pm-monitoring:programmatic": "node scripts/qa/test-pm-monitoring-programmatic.js",
    "integration:db:env": "cds env requires.db --profile integration",
    "integration:db:deploy": "cds deploy --profile integration",
    "integration:serve": "cds serve all --profile integration",
    "watch-bug-management-ui": "cds watch --open idts.bugmanagementui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/bug-management-ui"
  ],
  "cds": {
    "server": {
      "body_parser": {
        "limit": "12mb"
      }
    },
    "security": {
      "mock": {
        "defaultUsers": {
          "enabled": false
        }
      }
    },
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[integration]": {
          "kind": "postgres",
          "credentials": {
            "url": null
          }
        }
      },
      "attachments": {
        "[integration]": {
          "kind": "standard",
          "scan": false,
          "objectStore": {
            "kind": "shared"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "DonHV": {
              "roles": [
                "PM",
                "authenticated-user"
              ]
            },
            "SangVN": {
              "roles": [
                "DEVELOPER",
                "authenticated-user"
              ]
            },
            "DatDT": {
              "roles": [
                "DEVELOPER",
                "authenticated-user"
              ]
            },
            "NhanT": {
              "roles": [
                "TESTER",
                "authenticated-user"
              ]
            }
          }
        }
      }
    }
  }
}
