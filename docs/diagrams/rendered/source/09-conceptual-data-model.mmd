erDiagram
    USER {
        uuid ID
        string displayName
        string email
        string role
        boolean active
    }

    AUTH_SESSION {
        uuid ID
        uuid userID
        string tokenHash
        datetime expiresAt
        datetime revokedAt
    }

    DEVELOPER_PROFILE {
        uuid ID
        uuid userID
        string availabilityStatus
        int workloadLimit
        boolean active
    }

    SAP_MODULE {
        uuid ID
        string code
        string name
        boolean active
    }

    APPLICATION_COMPONENT {
        uuid ID
        string code
        string name
        string componentType
        boolean active
    }

    SAP_MODULE_COMPONENT {
        uuid ID
        uuid sapModuleID
        uuid componentID
        boolean active
    }

    DEFECT_CATEGORY {
        uuid ID
        string code
        string name
        string categoryType
        boolean active
    }

    COMPONENT_CATEGORY {
        uuid ID
        uuid componentID
        uuid defectCategoryID
        boolean active
    }

    DEVELOPER_RESPONSIBILITY {
        uuid ID
        uuid developerProfileID
        uuid componentCategoryID
        uuid sapModuleID
        string responsibilityLevel
        boolean active
    }

    BUG {
        uuid ID
        string bugNumber
        string title
        string description
        string status
        string priority
        string severity
        string environment
        string testCaseRef
        string testRunRef
        date plannedCompletionDate
        uuid sapModuleID
        uuid applicationComponentID
        uuid defectCategoryID
        uuid componentCategoryID
        uuid createdByID
        uuid assigneeID
        uuid nextProcessorID
        string nextProcessorRole
        string rejectionReason
        date dueDate
        decimal estimatedEffortHours
        datetime createdAt
        datetime updatedAt
    }

    COMMENT {
        uuid ID
        uuid bugID
        uuid authorID
        string authorRole
        string content
        datetime createdAt
    }

    BUG_ATTACHMENT {
        uuid ID
        uuid bugID
        string filename
        string mimeType
        string url
        int fileSize
        datetime createdAt
    }

    HISTORY_EVENT {
        uuid ID
        uuid bugID
        uuid actorID
        string actorRole
        string actionType
        string summary
        string reason
        datetime timestamp
    }

    HISTORY_LOG {
        uuid ID
        uuid bugID
        uuid eventID
        uuid actorID
        string actorRole
        string actionType
        string fieldName
        string fieldLabel
        string oldValue
        string oldValueDisplay
        string newValue
        string newValueDisplay
        string reason
        datetime timestamp
    }

    NOTIFICATION {
        uuid ID
        uuid bugID
        uuid recipientID
        string eventType
        string channel
        string deliveryStatus
        datetime createdAt
    }

    NOTIFICATION_DELIVERY {
        uuid ID
        uuid notificationID
        string channel
        string status
        int attemptCount
        datetime nextAttemptAt
        string lastErrorCode
    }

    AI_SUGGESTION {
        uuid ID
        uuid bugID
        uuid requestedByID
        uuid reviewedByID
        string featureType
        string reviewState
        decimal confidence
        datetime reviewedAt
    }

    DUPLICATE_LINK {
        uuid ID
        uuid sourceBugID
        uuid targetBugID
        string relationType
        datetime createdAt
    }

    USER ||--o{ BUG : creates
    USER ||--o{ AUTH_SESSION : authenticates_with
