  classDef decision fill:#f2edff,stroke:#7f65c5,color:#172b4d;
  classDef storage fill:#ecf8f1,stroke:#398b63,color:#172b4d;
  classDef deny fill:#fff0f0,stroke:#c65353,color:#7a1e1e;
  class Business,Write,Immediate,Scheduler,Processor,Batch,Claim,Send,Leave,Backoff,Complete action;
  class Email,Commit,PendingCheck,Eligible,Accepted,Retry decision;
  class Skipped,Pending,Sent,Failed storage;
  class Rollback,Final deny;
