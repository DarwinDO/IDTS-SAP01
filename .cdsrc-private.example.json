{
  "requires": {
    "db": {
      "[integration]": {
        "credentials": {
          "host": "<shared-postgresql-host>",
          "port": 5432,
          "database": "<shared-database-name>",
          "user": "<team-user-or-personal-user>",
          "password": "<private-password>",
          "ssl": true
        }
      }
    },
    "objectStore": {
      "credentials": {
        "bucket": "<private-aws-s3-bucket>",
        "region": "<aws-region>",
        "access_key_id": "<private-iam-access-key-id>",
        "secret_access_key": "<private-iam-secret-access-key>"
      }
    }
  },
  "idts": {
    "email": {
      "enabled": false,
      "provider": "smtp",
      "host": "<private-smtp-host>",
      "port": 587,
      "secure": false,
      "username": "<private-smtp-username>",
      "password": "<private-smtp-password-or-app-password>",
      "brevoApiKey": "<private-brevo-transactional-api-key>",
      "brevoApiEndpoint": "https://api.brevo.com/v3/smtp/email",
      "fromAddress": "verified-sender@example.com",
      "fromName": "IDTS Notifications",
      "replyTo": "",
      "baseUrl": "<optional-idts-app-base-url>",
      "maxRetryCount": 2,
      "pollIntervalMs": 15000,
      "batchSize": 10,
      "maxConnections": 3,
      "testMode": false,
      "defaultTestRecipient": ""
    },
    "ai": {
      "enabled": false,
      "provider": "mock",
      "timeoutMs": 10000,
      "maxInputChars": 8000,
      "modelAlias": "mock-chat",
      "embeddingModelAlias": "mock-embedding",
      "openaiApiKey": "<private-openai-api-key-or-use-OPENAI_API_KEY>",
      "mockMode": "success",
      "mockEmbeddingDimensions": 8
    }
  }
}
